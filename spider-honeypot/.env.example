# Copy this file to .env and adjust it for your machine. .env is not committed.

APP_ENV=development

# Local Postgres connection (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://honeypot_user:honeypot_pass@localhost:5432/spider_honeypot

LOG_LEVEL=INFO

# Which honeypot variants are active: all, none, semantic, prompt_injection or link_graph
HONEYPOT_VARIANT=all
