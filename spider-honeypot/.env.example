# Copy this file to .env and adjust for your local machine.
# .env is gitignored — never commit real values (not that these are secret,
# since this runs locally only, but it keeps the habit consistent).

APP_ENV=development

# Local Postgres connection (see docker-compose.yml for a matching local instance)
DATABASE_URL=postgresql+asyncpg://honeypot_user:honeypot_pass@localhost:5432/spider_honeypot

LOG_LEVEL=INFO
